# Copy to deploy/.env. Relative paths are relative to the deploy folder.

# Use only URL-safe characters, as the password is part of the database URL.
POSTGRES_PASSWORD=change-me

# Host name or IP address of the NAS.
SITE_ADDRESS=localhost

# Put the database and previews on an SSD if the NAS has one.
POSTGRES_DIR=./data/postgres
CACHE_DIR=./data/cache

# Originals, and the folder scanned for imports.
LIBRARY_DIR=./data/library
IMPORT_DIR=./data/import

# How long a file must stay unchanged before a folder scan imports it.
IMPORT_STABLE_SECONDS=60

# Photos processed at once. Keep at least one core free for the UI.
WORKERS=3

# Logs: debug, info, warn or error, as text or json. Debug adds every request.
LOG_LEVEL=info
LOG_FORMAT=text

# Nightly database dumps: where they go, when, and how many are kept.
BACKUP_DIR=./data/backups
BACKUP_TIME=03:00
BACKUP_KEEP=14
# Time zone for BACKUP_TIME, for example Europe/Moscow.
TZ=UTC
